@@ -0,0 +1,299 @@
+/**
+ * PROTOTYPE — itération 2 : panneaux flottants (ex-B) + barre haute (ex-C),
+ * angles resserrés ; on explore les palettes et la place de la barre haute.
+ * « Trois variantes de la coque basculables via `?variant=` sur toutes les routes. »
+ * Itération 1 (A Club house, B Terre battue, C Court central) : voir l'historique.
+ * Jetable : à archiver dans `.plan/` puis retirer une fois le choix fait.
+ */
+import { Archive, ChevronsUpDown, type LucideIcon } from "lucide-react";
+import { type ReactNode, Suspense } from "react";
+import { NavLink, Outlet, useLocation, useNavigate } from "react-router";
+import { navigationItems } from "@/app/navigation";
+import { useSeason } from "@/app/season";
+import { Loading } from "@/components/layout/Page";
+import { cn } from "@/lib/utils";
+import "./AppShell.prototype.css";
+
+export const SHELL_VARIANTS = [
+  { key: "0", name: "Actuel" },
+  { key: "D", name: "Court bleu — barre haute dans le panneau" },
+  { key: "E", name: "Graphite & sapin — barre haute pleine largeur" },
+  { key: "F", name: "Aubergine & sauge — barre haute dans le panneau" },
+] as const;
+export type ShellVariant = (typeof SHELL_VARIANTS)[number]["key"];
+
+const DETAIL_PAGE = /^\/referentiels\/(moniteurs|groupes)\/.+$/;
+
+const SECTIONS: { label: string; paths: string[] }[] = [
+  { label: "Planifier", paths: ["/planning", "/heures"] },
+  { label: "Gérer", paths: ["/referentiels", "/import-export"] },
+  { label: "Application", paths: ["/reglages", "/a-propos"] },
+];
+const itemsFor = (paths: string[]) => navigationItems.filter((i) => paths.includes(i.path));
+
+const PANEL = "proto-panel rounded-xl";
+
+function useSeasonSelect() {
+  const { season, seasons, readOnly, selectSeason } = useSeason();
+  const navigate = useNavigate();
+  const location = useLocation();
+  const onChange = (id: string) => {
+    const chosen = seasons.find((s) => s.id === id);
+    selectSeason(chosen && chosen.status !== "active" ? chosen.id : null);
+    const detail = DETAIL_PAGE.exec(location.pathname);
+    if (detail) navigate(`/referentiels/${detail[1]}`);
+  };
+  return { season, seasons, readOnly, onChange };
+}
+
+/** Sélecteur de saison : `<select>` natif invisible posé sur une pastille. */
+function SeasonPicker() {
+  const { season, seasons, readOnly, onChange } = useSeasonSelect();
+  if (seasons.length === 0) return null;
+  return (
+    <div className="relative">
+      <div
+        className={cn(
+          "flex h-8 items-center gap-2 rounded-md border px-2.5 text-xs shadow-xs transition-colors",
+          readOnly
+            ? "border-amber-300 bg-amber-50 text-amber-900 dark:border-amber-500/40 dark:bg-amber-500/10 dark:text-amber-200"
+            : "bg-card hover:bg-accent",
+        )}
+      >
+        {readOnly ? (
+          <Archive className="size-3.5" />
+        ) : (
+          <span className="proto-dot size-2 rounded-full" />
+        )}
+        <span className="text-muted-foreground">Saison</span>
+        <span className="font-semibold">{season?.name}</span>
+        <span className="text-muted-foreground">{readOnly ? "archivée" : "active"}</span>
+        <ChevronsUpDown className="size-3.5 text-muted-foreground" />
+      </div>
+      <select
+        aria-label="Saison consultée"
+        className="absolute inset-0 cursor-pointer opacity-0"
+        value={season?.id ?? ""}
+        onChange={(e) => onChange(e.target.value)}
+      >
+        {seasons.map((s) => (
+          <option key={s.id} value={s.id}>
+            {s.name}
+            {s.status === "archived" ? " (archivée)" : " (active)"}
+          </option>
+        ))}
+      </select>
+    </div>
+  );
+}
+
+function Breadcrumb({ withApp = true }: { withApp?: boolean }) {
+  const location = useLocation();
+  const current = navigationItems.find((i) => location.pathname.startsWith(i.path));
+  return (
+    <p className="flex items-center gap-2 text-sm">
+      {withApp && (
+        <>
+          <span className="text-muted-foreground">Planning Club</span>
+          <span className="text-muted-foreground/50">/</span>
+        </>
+      )}
+      <span className="font-medium">{current?.label}</span>
+    </p>
+  );
+}
+
+function Brand({ subtitle = true }: { subtitle?: boolean }) {
+  return (
+    <div className="flex items-center gap-2.5">
+      <img src="/favicon.svg" alt="" className="size-8 rounded-lg" />
+      <div className="leading-tight">
+        <p className="font-semibold text-sm tracking-tight">Planning Club</p>
+        {subtitle && <p className="text-muted-foreground text-xs">TC Lamorlaye</p>}
+      </div>
+    </div>
+  );
+}
+
+function Content({ banner }: { banner: ReactNode }) {
+  return (
+    <>
+      {banner}
+      <Suspense fallback={<Loading className="p-8 text-muted-foreground text-sm" />}>
+        <Outlet />
+      </Suspense>
+    </>
+  );
+}
+
+/** Entrées groupées par section ; le rendu de l'entrée active varie. */
+function SectionedNav({ item }: { item: (i: NavEntry) => ReactNode }) {
+  return (
+    <nav aria-label="Navigation principale" className="flex flex-1 flex-col gap-5 p-3">
+      {SECTIONS.map((section, i) => (
+        <div key={section.label} className={cn("flex flex-col gap-0.5", i === 2 && "mt-auto")}>
+          <p className="proto-section-label px-2.5 pb-1 font-medium text-[11px]">{section.label}</p>
+          {itemsFor(section.paths).map((entry) => (
+            <div key={entry.path}>{item(entry)}</div>
+          ))}
+        </div>
+      ))}
+    </nav>
+  );
+}
+type NavEntry = { path: string; label: string; icon: LucideIcon };
+
+const navBase =
+  "relative flex items-center gap-3 rounded-lg px-2.5 py-2 font-medium text-sm transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sidebar-ring";
+
+/* ------------------------------------------------------------------ D -- */
+
+/**
+ * D — Court bleu : panneaux blancs sur gris froid, bleu court en primaire,
+ * repère jaune balle sur l'entrée active, barre haute en tête du panneau.
+ */
+export function ShellD({ banner }: { banner: ReactNode }) {
+  return (
+    <div className="flex h-screen gap-2.5 overflow-hidden bg-background p-2.5">
+      <aside
+        className={cn(PANEL, "flex w-56 shrink-0 flex-col bg-sidebar text-sidebar-foreground")}
+      >
+        <div className="flex h-14 items-center border-sidebar-border border-b px-4">
+          <Brand />
+        </div>
+        <SectionedNav
+          item={({ path, label, icon: Icon }) => (
+            <NavLink
+              to={path}
+              className={({ isActive }) =>
+                cn(
+                  navBase,
+                  isActive
+                    ? "bg-sidebar-accent text-sidebar-accent-foreground"
+                    : "text-sidebar-foreground/70 hover:bg-sidebar-accent/60 hover:text-sidebar-foreground",
+                )
+              }
+            >
+              {({ isActive }) => (
+                <>
+                  <Icon className="size-4" strokeWidth={isActive ? 2.25 : 1.9} aria-hidden />
+                  {label}
+                  {isActive && <span className="proto-dot ml-auto size-1.5 rounded-full" />}
+                </>
+              )}
+            </NavLink>
+          )}
+        />
+      </aside>
+      <main className={cn(PANEL, "flex min-w-0 flex-1 flex-col overflow-auto bg-card")}>
+        <div className="sticky top-0 z-20 flex h-14 shrink-0 items-center justify-between gap-4 border-b bg-card/85 px-6 backdrop-blur">
+          <Breadcrumb />
+          <SeasonPicker />
+        </div>
+        <Content banner={banner} />
+      </main>
+    </div>
+  );
+}
+
+/* ------------------------------------------------------------------ E -- */
+
+/**
+ * E — Graphite & sapin : barre haute pleine largeur posée sur le fond
+ * (logo, fil d'Ariane, saison), puis deux panneaux : sidebar graphite et contenu.
+ */
+export function ShellE({ banner }: { banner: ReactNode }) {
+  return (
+    <div className="flex h-screen flex-col overflow-hidden bg-background">
+      <header className="flex h-14 shrink-0 items-center gap-4 px-5">
+        <div className="w-[13.25rem]">
+          <Brand subtitle={false} />
+        </div>
+        <Breadcrumb withApp={false} />
+        <div className="ml-auto">
+          <SeasonPicker />
+        </div>
+      </header>
+      <div className="flex min-h-0 flex-1 gap-2.5 px-2.5 pb-2.5">
+        <aside
+          className={cn(PANEL, "flex w-56 shrink-0 flex-col bg-sidebar text-sidebar-foreground")}
+        >
+          <SectionedNav
+            item={({ path, label, icon: Icon }) => (
+              <NavLink
+                to={path}
+                className={({ isActive }) =>
+                  cn(
+                    navBase,
+                    isActive
+                      ? "bg-sidebar-accent text-sidebar-accent-foreground"
+                      : "text-sidebar-foreground/65 hover:bg-white/5 hover:text-sidebar-foreground",
+                  )
+                }
+              >
+                {({ isActive }) => (
+                  <>
+                    <Icon
+                      className={cn("size-4", isActive && "text-sidebar-primary")}
+                      strokeWidth={isActive ? 2.25 : 1.9}
+                      aria-hidden
+                    />
+                    {label}
+                  </>
+                )}
+              </NavLink>
+            )}
+          />
+        </aside>
+        <main className={cn(PANEL, "flex min-w-0 flex-1 flex-col overflow-auto bg-card")}>
+          <Content banner={banner} />
+        </main>
+      </div>
+    </div>
+  );
+}
+
+/* ------------------------------------------------------------------ F -- */
+
+/**
+ * F — Aubergine & sauge : fond pierre chaud, entrée active pleine aubergine,
+ * barre haute en tête du panneau, sections soulignées de sauge.
+ */
+export function ShellF({ banner }: { banner: ReactNode }) {
+  return (
+    <div className="flex h-screen gap-2.5 overflow-hidden bg-background p-2.5">
+      <aside
+        className={cn(PANEL, "flex w-56 shrink-0 flex-col bg-sidebar text-sidebar-foreground")}
+      >
+        <div className="flex h-14 items-center px-4">
+          <Brand />
+        </div>
+        <SectionedNav
+          item={({ path, label, icon: Icon }) => (
+            <NavLink
+              to={path}
+              className={({ isActive }) =>
+                cn(
+                  navBase,
+                  isActive
+                    ? "bg-sidebar-primary text-sidebar-primary-foreground shadow-sm"
+                    : "text-sidebar-foreground/75 hover:bg-sidebar-accent hover:text-sidebar-accent-foreground",
+                )
+              }
+            >
+              <Icon className="size-4" aria-hidden />
+              {label}
+            </NavLink>
+          )}
+        />
+      </aside>
+      <main className={cn(PANEL, "flex min-w-0 flex-1 flex-col overflow-auto bg-card")}>
+        <div className="sticky top-0 z-20 flex h-14 shrink-0 items-center justify-between gap-4 border-b bg-card/85 px-6 backdrop-blur">
+          <Breadcrumb />
+          <SeasonPicker />
+        </div>
+        <Content banner={banner} />
+      </main>
+    </div>
+  );
+}
