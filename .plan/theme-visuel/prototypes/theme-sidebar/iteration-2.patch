+/*
+ * PROTOTYPE — palettes de l'itération 2 (voir AppShell.prototype.tsx).
+ * `html[data-proto]` l'emporte sur `:root` (spécificité supérieure).
+ * Angles : boutons/champs 6 px (--radius 0.5rem), panneaux 12 px.
+ */
+
+html[data-proto="D"],
+html[data-proto="E"],
+html[data-proto="F"] {
+  --radius: 0.5rem;
+}
+
+.proto-panel {
+  border: 1px solid var(--border);
+  box-shadow:
+    0 1px 2px oklch(0.2 0.02 260 / 0.05),
+    0 6px 20px -10px oklch(0.2 0.02 260 / 0.12);
+}
+.proto-section-label {
+  color: color-mix(in oklch, var(--sidebar-foreground) 50%, transparent);
+}
+.proto-dot {
+  background: var(--proto-highlight, var(--primary));
+}
+
+html[data-proto] [data-slot="page-header"] {
+  padding: 1.5rem 1.75rem 1.125rem;
+}
+html[data-proto] [data-slot="page-header"] h1 {
+  font-size: 1.375rem;
+  font-weight: 650;
+  letter-spacing: -0.02em;
+}
+html[data-proto] [data-slot="page-header"] + div {
+  padding: 1.5rem 1.75rem;
+}
+
+/* ------------------------------------------------------ D — Court bleu --- */
+
+html[data-proto="D"] {
+  --background: oklch(0.95 0.007 255);
+  --foreground: oklch(0.21 0.025 262);
+  --card: oklch(1 0 0);
+  --card-foreground: oklch(0.21 0.025 262);
+  --popover: oklch(1 0 0);
+  --popover-foreground: oklch(0.21 0.025 262);
+  --primary: oklch(0.5 0.16 262);
+  --primary-foreground: oklch(0.99 0 0);
+  --secondary: oklch(0.955 0.008 255);
+  --secondary-foreground: oklch(0.25 0.03 262);
+  --muted: oklch(0.965 0.006 255);
+  --muted-foreground: oklch(0.52 0.02 258);
+  --accent: oklch(0.955 0.022 262);
+  --accent-foreground: oklch(0.42 0.15 262);
+  --border: oklch(0.915 0.008 255);
+  --input: oklch(0.885 0.01 255);
+  --ring: oklch(0.5 0.16 262);
+  --sidebar: oklch(1 0 0);
+  --sidebar-foreground: oklch(0.21 0.025 262);
+  --sidebar-primary: oklch(0.5 0.16 262);
+  --sidebar-primary-foreground: oklch(0.99 0 0);
+  --sidebar-accent: oklch(0.95 0.025 262);
+  --sidebar-accent-foreground: oklch(0.42 0.16 262);
+  --sidebar-border: oklch(0.925 0.008 255);
+  --sidebar-ring: oklch(0.5 0.16 262);
+  --proto-highlight: oklch(0.84 0.2 125);
+}
+
+/* ------------------------------------------------- E — Graphite & sapin --- */
+
+html[data-proto="E"] {
+  --background: oklch(0.955 0.003 250);
+  --foreground: oklch(0.2 0.01 260);
+  --card: oklch(1 0 0);
+  --card-foreground: oklch(0.2 0.01 260);
+  --popover: oklch(1 0 0);
+  --popover-foreground: oklch(0.2 0.01 260);
+  --primary: oklch(0.5 0.105 172);
+  --primary-foreground: oklch(0.99 0.01 170);
+  --secondary: oklch(0.955 0.004 250);
+  --secondary-foreground: oklch(0.24 0.01 260);
+  --muted: oklch(0.965 0.003 250);
+  --muted-foreground: oklch(0.52 0.01 260);
+  --accent: oklch(0.955 0.022 172);
+  --accent-foreground: oklch(0.38 0.08 172);
+  --border: oklch(0.915 0.004 250);
+  --input: oklch(0.885 0.005 250);
+  --ring: oklch(0.5 0.105 172);
+  --sidebar: oklch(0.235 0.008 260);
+  --sidebar-foreground: oklch(0.94 0.004 260);
+  --sidebar-primary: oklch(0.8 0.12 172);
+  --sidebar-primary-foreground: oklch(0.2 0.04 172);
+  --sidebar-accent: oklch(1 0 0 / 9%);
+  --sidebar-accent-foreground: oklch(1 0 0);
+  --sidebar-border: oklch(1 0 0 / 8%);
+  --sidebar-ring: oklch(0.8 0.12 172);
+  --proto-highlight: oklch(0.62 0.13 172);
+}
+
+/* ----------------------------------------------- F — Aubergine & sauge --- */
+
+html[data-proto="F"] {
+  --background: oklch(0.955 0.008 80);
+  --foreground: oklch(0.22 0.02 300);
+  --card: oklch(0.995 0.002 80);
+  --card-foreground: oklch(0.22 0.02 300);
+  --popover: oklch(0.995 0.002 80);
+  --popover-foreground: oklch(0.22 0.02 300);
+  --primary: oklch(0.43 0.13 308);
+  --primary-foreground: oklch(0.99 0.005 300);
+  --secondary: oklch(0.955 0.008 80);
+  --secondary-foreground: oklch(0.26 0.03 300);
+  --muted: oklch(0.96 0.007 80);
+  --muted-foreground: oklch(0.52 0.02 300);
+  --accent: oklch(0.945 0.03 140);
+  --accent-foreground: oklch(0.38 0.07 145);
+  --border: oklch(0.91 0.01 80);
+  --input: oklch(0.88 0.012 80);
+  --ring: oklch(0.43 0.13 308);
+  --sidebar: oklch(0.995 0.002 80);
+  --sidebar-foreground: oklch(0.22 0.02 300);
+  --sidebar-primary: oklch(0.43 0.13 308);
+  --sidebar-primary-foreground: oklch(0.99 0.005 300);
+  --sidebar-accent: oklch(0.95 0.025 140);
+  --sidebar-accent-foreground: oklch(0.36 0.07 145);
+  --sidebar-border: oklch(0.92 0.01 80);
+  --sidebar-ring: oklch(0.43 0.13 308);
+  --proto-highlight: oklch(0.65 0.1 145);
+}
+html[data-proto="F"] .proto-section-label {
+  color: oklch(0.5 0.06 145);
+}
+
+/* ------------------------------------------------------- Mode sombre --- */
+
+@media (prefers-color-scheme: dark) {
+  .proto-panel {
+    box-shadow: 0 1px 2px oklch(0 0 0 / 0.3);
+  }
+
+  html[data-proto="D"] {
+    --background: oklch(0.14 0.015 262);
+    --foreground: oklch(0.95 0.008 255);
+    --card: oklch(0.19 0.02 262);
+    --card-foreground: oklch(0.95 0.008 255);
+    --popover: oklch(0.19 0.02 262);
+    --popover-foreground: oklch(0.95 0.008 255);
+    --primary: oklch(0.68 0.15 262);
+    --primary-foreground: oklch(0.16 0.04 262);
+    --secondary: oklch(0.25 0.02 262);
+    --secondary-foreground: oklch(0.95 0.008 255);
+    --muted: oklch(0.24 0.02 262);
+    --muted-foreground: oklch(0.7 0.02 258);
+    --accent: oklch(0.27 0.045 262);
+    --accent-foreground: oklch(0.9 0.06 262);
+    --border: oklch(1 0 0 / 9%);
+    --input: oklch(1 0 0 / 14%);
+    --ring: oklch(0.68 0.15 262);
+    --sidebar: oklch(0.19 0.02 262);
+    --sidebar-foreground: oklch(0.95 0.008 255);
+    --sidebar-primary: oklch(0.68 0.15 262);
+    --sidebar-primary-foreground: oklch(0.16 0.04 262);
+    --sidebar-accent: oklch(0.27 0.045 262);
+    --sidebar-accent-foreground: oklch(0.92 0.05 262);
+    --sidebar-border: oklch(1 0 0 / 8%);
+    --sidebar-ring: oklch(0.68 0.15 262);
+  }
+
+  html[data-proto="E"] {
+    --background: oklch(0.13 0.004 260);
+    --foreground: oklch(0.95 0.004 260);
+    --card: oklch(0.185 0.006 260);
+    --card-foreground: oklch(0.95 0.004 260);
+    --popover: oklch(0.185 0.006 260);
+    --popover-foreground: oklch(0.95 0.004 260);
+    --primary: oklch(0.72 0.11 172);
+    --primary-foreground: oklch(0.18 0.03 172);
+    --secondary: oklch(0.25 0.006 260);
+    --secondary-foreground: oklch(0.95 0.004 260);
+    --muted: oklch(0.24 0.006 260);
+    --muted-foreground: oklch(0.7 0.008 260);
+    --accent: oklch(0.27 0.03 172);
