+/**
+ * PROTOTYPE — barre flottante de bascule entre variantes (`?variant=`).
+ * Jetable : à retirer de l'application une fois la variante choisie.
+ */
+import { ChevronLeft, ChevronRight } from "lucide-react";
+import { useCallback, useEffect } from "react";
+import { useSearchParams } from "react-router";
+
+const STORAGE_KEY = "prototype-variant";
+
+/**
+ * Variante courante : paramètre `?variant=` de l'URL, sinon la dernière
+ * choisie (mémorisée pour survivre aux liens internes qui perdent le paramètre).
+ */
+export function usePrototypeVariant<K extends string>(keys: readonly K[], fallback: K) {
+  const [params, setParams] = useSearchParams();
+  const fromUrl = params.get("variant");
+  let stored: string | null = null;
+  try {
+    stored = sessionStorage.getItem(STORAGE_KEY);
+  } catch {}
+  const raw = fromUrl ?? stored;
+  const variant = keys.includes(raw as K) ? (raw as K) : fallback;
+
+  useEffect(() => {
+    try {
+      sessionStorage.setItem(STORAGE_KEY, variant);
+    } catch {}
+  }, [variant]);
+
+  const setVariant = useCallback(
+    (next: K) => {
+      setParams(
+        (prev) => {
+          const p = new URLSearchParams(prev);
+          p.set("variant", next);
+          return p;
+        },
+        { replace: true },
+      );
+    },
+    [setParams],
+  );
+  return [variant, setVariant] as const;
+}
+
+interface PrototypeSwitcherProps<K extends string> {
+  variants: readonly { key: K; name: string }[];
+  current: K;
+  onChange: (key: K) => void;
+}
+
+export function PrototypeSwitcher<K extends string>({
+  variants,
+  current,
+  onChange,
+}: PrototypeSwitcherProps<K>) {
+  const index = Math.max(
+    0,
+    variants.findIndex((v) => v.key === current),
+  );
+  const cycle = useCallback(
+    (delta: number) => {
+      const next = variants[(index + delta + variants.length) % variants.length];
+      if (next) onChange(next.key);
+    },
+    [index, variants, onChange],
+  );
+
+  useEffect(() => {
+    const onKey = (e: KeyboardEvent) => {
+      const t = e.target as HTMLElement | null;
+      if (t?.closest("input, textarea, select, [contenteditable]")) return;
+      if (e.key === "ArrowLeft") cycle(-1);
+      if (e.key === "ArrowRight") cycle(1);
+    };
+    window.addEventListener("keydown", onKey);
+    return () => window.removeEventListener("keydown", onKey);
+  }, [cycle]);
+
+  if (!import.meta.env.DEV) return null;
+  const v = variants[index];
+  return (
+    <div
+      style={{ fontFamily: "ui-monospace, monospace" }}
+      className="fixed bottom-4 left-1/2 z-[9999] flex -translate-x-1/2 items-center gap-1 rounded-full bg-black px-2 py-1.5 text-white text-xs shadow-2xl ring-2 ring-fuchsia-500"
+    >
+      <button
+        type="button"
+        aria-label="Variante précédente"
+        className="rounded-full p-1 hover:bg-white/20"
+        onClick={() => cycle(-1)}
+      >
+        <ChevronLeft className="size-4" />
+      </button>
+      <span className="min-w-56 text-center">
+        <b className="text-fuchsia-300">PROTO</b> {v?.key} ({v?.name}) · {index + 1}/
+        {variants.length}
+      </span>
+      <button
+        type="button"
+        aria-label="Variante suivante"
+        className="rounded-full p-1 hover:bg-white/20"
+        onClick={() => cycle(1)}
+      >
+        <ChevronRight className="size-4" />
+      </button>
+    </div>
+  );
+}
